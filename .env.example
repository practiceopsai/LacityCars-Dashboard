# ---------------------------------------------------------------------------
# LacityCars-Dashboard environment template.
# Copy to .env and fill in real values. NEVER commit .env or real secrets.
# Railway tokens/credentials belong in the Railway dashboard, never in this repo.
# ---------------------------------------------------------------------------

# --- Shared infrastructure -------------------------------------------------
DATABASE_URL=postgresql://lacity:lacity_local_dev@localhost:5432/lacity
REDIS_URL=redis://localhost:6379

# --- API service (apps/api) ------------------------------------------------
API_PORT=4000
# Origin of the dashboard, used for CORS when the web app proxies /api/*.
WEB_ORIGIN=http://localhost:3000
# Random 32+ char string. Signs the operator session cookie. Server-only.
SESSION_SECRET=change-me-generate-a-long-random-string
# Single-operator dashboard password. Server-only; never shipped to the browser.
OPERATOR_PASSWORD=change-me-strong-operator-password
# Shared secret Hermes uses to sign webhook callbacks (HMAC-SHA256).
HERMES_WEBHOOK_SECRET=change-me-webhook-signing-secret

# --- Worker service (apps/worker) ------------------------------------------
# Hermes native webhook route on the Orgo Windows computer.
HERMES_ENDPOINT=https://www.orgo.ai/api/computers/computer-id/bash
# Local-only Hermes route reached by the authenticated Orgo command bridge.
HERMES_LOCAL_WEBHOOK_URL=http://127.0.0.1:8644/webhooks/vehicle-stocking
# HMAC-v2 secret shared with the Hermes webhook route.
HERMES_TRIGGER_SECRET=change-me-64-character-hmac-secret
# Optional transport-layer bearer token (the Orgo API token for Orgo URLs).
HERMES_PROXY_TOKEN=
# Fail closed if Hermes accepts a job but never sends a terminal callback.
HERMES_PROCESSING_TIMEOUT_MS=5400000
HERMES_WATCHDOG_INTERVAL_MS=60000
# Orgo bridge only: after launching the detached delivery, poll the delivery's
# stdout log until the gateway's {"status":"accepted"} appears. A dead loopback
# gateway fails the trigger within this window (worker retry / FAILED event)
# instead of ripening into a processing-watchdog timeout.
HERMES_DELIVERY_VERIFY_MS=90000
HERMES_DELIVERY_POLL_MS=5000
# Public base URL of the API, used to build the webhook callback URL.
PUBLIC_API_URL=http://localhost:4000
# Dispatch workbook source: provide exactly one of URL or PATH.
DISPATCH_WORKBOOK_URL=
DISPATCH_WORKBOOK_PATH=./fixtures/dispatch.xlsx
# Optional tuning (defaults shown).
FREIGHT_MAX_ATTEMPTS=20
FREIGHT_BACKOFF_BASE_MS=300000
FREIGHT_BACKOFF_MAX_MS=21600000
# Durable full-queue checks at 8 AM and 8 PM Eastern every day.
FREIGHT_SWEEP_CRON=0 8,20 * * *
FREIGHT_SWEEP_TIME_ZONE=America/New_York

# --- Web service (apps/web) ------------------------------------------------
# Internal URL of the API; Next.js rewrites /api/* here (server-side only).
API_URL=http://localhost:4000

# --- Mail-intake service (apps/mail-intake) --------------------------------
# Staff email vehicles (PDF/XLSX/CSV) to an AgentMail inbox; this service
# extracts VIN/model/store/source, validates, and queues them via the API.
# AgentMail credentials (console: agentmail.to). Webhook secret is the Svix
# endpoint secret (whsec_...) shown when the webhook is created.
AGENTMAIL_API_KEY=
AGENTMAIL_INBOX_ID=stocking@yourorg.agentmail.to
AGENTMAIL_WEBHOOK_SECRET=
# Comma-separated senders allowed to submit vehicles. Anyone else is ignored
# and flagged to ALERT_EMAIL. This is the primary security gate.
STAFF_ALLOWLIST=fvarenns@gmail.com
ALERT_EMAIL=fvarenns@gmail.com
# Dashboard API target + operator credential (same password the UI uses).
API_BASE_URL=http://localhost:4000
# Public URL of THIS service; the Hermes agent posts extraction results to
# ${PUBLIC_BASE_URL}/callbacks/extraction.
PUBLIC_BASE_URL=http://localhost:4100
# HMAC secret for that callback (>=32 chars). The same value must live on the
# Windows host at C:\data\mail-intake\callback-secret.txt for
# integrations/hermes/extraction_callback.py.
EXTRACTION_CALLBACK_SECRET=
# HMAC secret for the gateway's email-intake route (>=32 chars) — matches the
# `secret:` under routes.email-intake in the gateway config.yaml.
HERMES_EXTRACTION_SECRET=
# PDF extraction rides the same Orgo bash transport the worker uses
# (HERMES_ENDPOINT / HERMES_LOCAL_WEBHOOK_URL / HERMES_PROXY_TOKEN above).
# How long a PDF may stay with the reader before the email is bounced.
EXTRACTION_TIMEOUT_MS=1200000
# Shadow mode: parse + reply but never queue. Use during rollout.
DRY_RUN=true
